{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CodeAtlas Extension (F5)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/integrations/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/integrations/vscode/dist/**/*.js"
      ],
      "preLaunchTask": "npm: compile (vscode)"
    }
  ]
}
