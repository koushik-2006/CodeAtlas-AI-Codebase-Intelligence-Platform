# CodeAtlas Backend Environment Configuration

# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=True
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","https://your-friend.github.io"]

# Security & Sessions
SECRET_KEY=replace-with-a-very-secure-random-string-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# GitHub Integration (OAuth / App)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/github/callback

# AI Provider Configuration (openai | gemini | mock)
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Storage & Database (In-Memory for Phase A; PostgreSQL for Phase B)
DATABASE_TYPE=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codeatlas

# Limits & Safety
MAX_FILE_SIZE_BYTES=1048576
MAX_REPO_FILES_INDEX=500
