{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "incremental": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "firebase/ai": [
        "./node_modules/@firebase/ai/dist/ai-public.d.ts"
      ],
      "firebase/app-check": [
        "./node_modules/@firebase/app-check/dist/app-check-public.d.ts"
      ],
      "firebase/auth": [
        "./node_modules/@firebase/auth/dist/auth-public.d.ts"
      ],
      "firebase/app": [
        "./node_modules/@firebase/app/dist/app-public.d.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "integrations",
    "pages_export_workspace",
    "out"
  ]
}
