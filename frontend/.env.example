# =============================================================================
# CodeAtlas AI Codebase Intelligence Platform Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND CLIENT CONFIGURATION (Static Export / GitHub Pages / SPA)
# -----------------------------------------------------------------------------
# Public Application URL (used for metadata, open-graph cards, sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Identity Services Client ID (Public configuration)
# Web application OAuth Client ID configured in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=13168760256-mebb2hjbi0nl6hnlcclqoeaognkqu8ru.apps.googleusercontent.com

# Public Backend API Gateway URL (Canonical)
# Local Development: http://localhost:8000/api/v1 (FastAPI) or /api/v1 (Next.js reverse proxy)
# Production (GitHub Pages -> FastAPI Backend): https://api.codeatlas.example.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional: Set to 'true' if deploying to a custom domain rather than USERNAME.github.io/REPOSITORY
# CUSTOM_DOMAIN=true

# -----------------------------------------------------------------------------
# 2. MEMBER 2 HOSTED BACKEND & SERVER RUNTIME CONFIGURATION
# (Keep on separately hosted backend server; NEVER expose in static builds)
# -----------------------------------------------------------------------------

# Cross-Origin Resource Sharing (CORS) Configuration for Member 2's backend
# Add your GitHub Pages URL here so the browser can make authenticated API calls
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://username.github.io

# Server Session & Encryption Secret (32+ character random string)
SESSION_SECRET=your_random_32_character_session_secret_here

# Google OAuth (Primary Identity Provider)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth Integration (Repository Ingestion, AST Parsing & User Authorization)
# Register a GitHub OAuth App at: https://github.com/settings/developers
# 1. Open GitHub Settings -> Developer settings -> OAuth Apps -> New OAuth App
# 2. Application Name: CodeAtlas (or CodeAtlas Development)
# 3. Homepage URL: http://localhost:3000 (Local) or your production domain
# 4. Authorization callback URL: http://localhost:3000/api/auth/github/callback (Local)
#    or https://api.yourdomain.com/api/auth/github/callback (Production backend)
# 5. Copy Client ID and generate a Client Secret.
# 6. Save only on server runtime; NEVER expose in browser-side NEXT_PUBLIC_ variables.
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
APP_BASE_URL=http://localhost:3000
DATABASE_URL=file:./data/codeatlas-db.json

# AI Models & Vision OCR Providers (Deterministic AST fallback runs offline out-of-the-box)
# Google Gemini (Official @google/genai SDK — Grounded chat & Vision OCR)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI GPT-4o / GPT-4o-mini (Reasoning & CodeLens Vision OCR)
OPENAI_API_KEY=your_openai_api_key

# Anthropic Claude 3.5 Sonnet (Architecture analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key

# -----------------------------------------------------------------------------
# 3. EMAIL DELIVERY SERVICE CONFIGURATION (OTP Verification & Password Recovery)
# -----------------------------------------------------------------------------
# Sender display identity
EMAIL_FROM="CodeAtlas <no-reply@codeatlas.dev>"

# Option A: Standard SMTP (Gmail, Outlook, Amazon SES, SendGrid SMTP, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Option B: Resend REST API (https://resend.com)
# RESEND_API_KEY=re_your_resend_api_key_here

# Option C: SendGrid REST API (https://sendgrid.com)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Local Development / Sandbox Mode (Default when no external credentials configured):
# In development (NODE_ENV !== "production"), outgoing verification emails are safely
# stored in data/dev-mailbox.json for inspection without sending to real inboxes.

