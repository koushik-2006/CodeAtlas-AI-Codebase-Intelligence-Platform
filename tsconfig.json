{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "incremental": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./frontend/*"
      ],
      "firebase/ai": [
        "./frontend/node_modules/@firebase/ai/dist/ai-public.d.ts"
      ],
      "firebase/app-check": [
        "./frontend/node_modules/@firebase/app-check/dist/app-check-public.d.ts"
      ],
      "firebase/auth": [
        "./frontend/node_modules/firebase/node_modules/@firebase/auth/dist/auth-public.d.ts",
        "./frontend/node_modules/@firebase/auth/dist/auth-public.d.ts"
      ],
      "firebase/app": [
        "./frontend/node_modules/@firebase/app/dist/app-public.d.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend/node_modules",
    "frontend/out",
    "frontend/pages_export_workspace"
  ]
}
